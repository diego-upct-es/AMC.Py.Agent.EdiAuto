# ══════════════════════════════════════════════════════════════
# AMC.Py.Agent.EdiAuto — Variables de entorno
# Copiar a .env y rellenar. .env NO se sube a Git.
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# Selección de proveedor de IA: "oracle" o "azure"
# ──────────────────────────────────────────────────────────────
AI_PROVIDER=oracle

# ──────────────────────────────────────────────────────────────
# Oracle Generative AI
# ──────────────────────────────────────────────────────────────
ORACLE_AI_ENDPOINT=
ORACLE_AI_API_KEY=
ORACLE_AI_MODEL=

# ──────────────────────────────────────────────────────────────
# Azure OpenAI (vía Azure AI Foundry) — alternativa mientras no haya
# acceso a Oracle AI.
# La clave de API va aquí SOLO de forma temporal (indicación de Fede,
# 2026-08-13): en cuanto exista el secreto qa-ConnectionStrings--AzureOpenAI
# en Key Vault, esto se retira de aquí y pasa a leerse de ahí, igual que
# la connection string de la BD y la de Service Bus.
# ──────────────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# ──────────────────────────────────────────────────────────────
# AMC.Core.Sys.Mailing
# En QA: BYPASS_AUTH=SI activo → sin autenticación JWT
# ──────────────────────────────────────────────────────────────
MAILING_BASE_URL=https://sys-mailing-qa-private.msa.amcglobalco.com
MAILING_EDI_MAILBOX=integrations_test@amcglobalco.com
# MAILING_EDI_MAILBOX=edi.support@amcglobalco.com  ← producción

# ──────────────────────────────────────────────────────────────
# AMC.Core.SysEdi — herramientas del agente
# ──────────────────────────────────────────────────────────────
SYS_EDI_URL=https://sys-edi-{entorno}-private.msa.amcglobalco.com
# Override manual y TEMPORAL: fuerza el entorno del SysEdi (p. ej. "pro")
# sin cambiar ENVIRONMENT, que también movería la BD y la cola de Service
# Bus a ese entorno. Dejar vacío/comentado salvo prueba puntual controlada.
# Cuidado: si se activa, los pasos [SIDE-EFFECT] del plan (write_file,
# move_file, resend_message) actuarían sobre ficheros reales de ese entorno.
# SYS_EDI_ENTORNO_OVERRIDE=pro

# ──────────────────────────────────────────────────────────────
# Azure Service Bus (mismo que usan PrcSd y otros microservicios AMC)
# La connection string ya NO se lee de aquí: viene de Key Vault
# (secreto qa-ConnectionStrings--AzureServiceBus). El nombre de cola
# se calcula solo por entorno ({entorno}.py.agent.events) — déjalo
# comentado salvo que necesites forzar un nombre distinto al calculado.
# ──────────────────────────────────────────────────────────────
# AZURE_SERVICEBUS_QUEUE_NAME=qa.py.agent.events

# ──────────────────────────────────────────────────────────────
# Base de Datos PostgreSQL
# La connection string ya NO se lee de aquí: viene de Key Vault
# (secreto qa-ConnectionStrings--EdiAuto).
# ──────────────────────────────────────────────────────────────
DB_POOL_SIZE=10

# ──────────────────────────────────────────────────────────────
# Configuración del sistema
# ──────────────────────────────────────────────────────────────
EMAIL_POLL_INTERVAL_SECONDS=300
INTERNAL_ALERT_EMAIL=
ENVIRONMENT=development
